# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Same Supabase project as the customer-facing storefront — the admin
# dashboard only ever writes through the logged-in admin's own session
# plus Row Level Security, so it uses the public anon/publishable key too.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# The deployed URL of the customer-facing storefront (the "client" app),
# used for the "View shop" / "View product" links in the dashboard.
VITE_STOREFRONT_URL=https://essylux.com
